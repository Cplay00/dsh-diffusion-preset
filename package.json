{
  "name": "dsh-diffusion-preset",
  "version": "1.2.1",
  "type": "module",
  "description": "提供可配置的轻量初始工具集与 call_directory 调用目录，按需发现和挂载工具、技能、MCP 与插件能力，支持 Native 和 PTC。减少无关工具定义对上下文的占用与干扰，有助于模型聚焦当前任务；可卸载工具以控制后续上下文规模。",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "preset",
    "diffusion",
    "tools",
    "workflow",
    "progressive-disclosure"
  ],
  "author": {
    "name": "Cplay00",
    "url": "https://github.com/Cplay00"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Cplay00/dsh-diffusion-preset.git"
  },
  "homepage": "https://github.com/Cplay00/dsh-diffusion-preset#readme",
  "bugs": {
    "url": "https://github.com/Cplay00/dsh-diffusion-preset/issues"
  },
  "license": "MIT",
  "scripts": {
    "sync": "node sync-catalog.js"
  },
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./catalog-builder": "./catalog-builder.js",
    "./runtime": "./runtime.js",
    "./runtime-v2": "./runtime-v2.js",
    "./runtime-v2/locale/*.json": "./locale/*.json",
    "./runtime-v2/icon": "./icon.svg",
    "./runtime/locale/*.json": "./locale/*.json",
    "./runtime/icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "runtime.js",
    "runtime-v2.js",
    "catalog-builder.js",
    "cordis.patch.yml",
    "CATALOG.md",
    "locale/*.json",
    "icon.svg",
    "assets/*",
    "screenshots.json",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
